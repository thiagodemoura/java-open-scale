<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openscale</groupId>
        <artifactId>openscale-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>openscale-cli</artifactId>
    <name>openScale :: CLI</name>
    <description>Linha de comando: simula a balança, reproduz capturas e sincroniza medições.</description>

    <dependencies>
        <dependency>
            <groupId>com.openscale</groupId>
            <artifactId>openscale-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openscale</groupId>
            <artifactId>openscale-scales</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openscale</groupId>
            <artifactId>openscale-sync-mqtt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openscale</groupId>
            <artifactId>openscale-sync-wger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openscale</groupId>
            <artifactId>openscale-sync-healthconnect</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>openscale-cli</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <!-- junta os META-INF/services de todos os módulos (balanças e sync) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.openscale.cli.Main</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
